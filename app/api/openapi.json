{
  "openapi": "3.1.0",
  "info": {
    "title": "DwellWise API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "The process is up. Used by the platform to restart a dead container.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "The database answers and every required source is fresh.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          }
        }
      }
    },
    "/v1/counties": {
      "get": {
        "tags": [
          "counties"
        ],
        "summary": "List Counties",
        "description": "Every county, with how many settlements it contains.",
        "operationId": "list_counties_v1_counties_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/County"
                  },
                  "type": "array",
                  "title": "Response List Counties V1 Counties Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/counties/{name}/settlements": {
      "get": {
        "tags": [
          "counties"
        ],
        "summary": "County Settlements",
        "description": "The county's settlements, A to Z.",
        "operationId": "county_settlements_v1_counties__name__settlements_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z \\-]{1,30}$",
              "description": "County name, any case",
              "title": "Name"
            },
            "description": "County name, any case"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SettlementSummary"
                  },
                  "title": "Response County Settlements V1 Counties  Name  Settlements Get"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/settlements": {
      "get": {
        "tags": [
          "settlements"
        ],
        "summary": "Search Settlements",
        "description": "Settlements whose name contains the query; exact and prefix matches first.",
        "operationId": "search_settlements_v1_settlements_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Part of a settlement name",
              "title": "Q"
            },
            "description": "Part of a settlement name"
          },
          {
            "name": "county",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ],
              "description": "Limit to one county",
              "title": "County"
            },
            "description": "Limit to one county"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SettlementSummary"
                  },
                  "title": "Response Search Settlements V1 Settlements Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/settlements/{code}": {
      "get": {
        "tags": [
          "settlements"
        ],
        "summary": "Get Settlement",
        "operationId": "get_settlement_v1_settlements__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-Za-z_-]{1,20}$",
              "description": "CSO settlement code",
              "title": "Code"
            },
            "description": "CSO settlement code"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/settlements/{code}/brief": {
      "get": {
        "tags": [
          "settlements"
        ],
        "summary": "Get Brief",
        "description": "The pre-planning brief: the sections whose data has landed, and which are still pending.",
        "operationId": "get_brief_v1_settlements__code__brief_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-Za-z_-]{1,20}$",
              "description": "CSO settlement code",
              "title": "Code"
            },
            "description": "CSO settlement code"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Brief"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stats/applications": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Application Stats",
        "description": "Planning applications received each month, counted by their current decision class.",
        "operationId": "application_stats_v1_stats_applications_get",
        "parameters": [
          {
            "name": "county",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z \\-]{1,30}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "County name; none means Ireland",
              "title": "County"
            },
            "description": "County name; none means Ireland"
          },
          {
            "name": "residential",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "true: only applications that state dwellings",
              "title": "Residential"
            },
            "description": "true: only applications that state dwellings"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First month, YYYY-MM",
              "title": "From"
            },
            "description": "First month, YYYY-MM"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last month, YYYY-MM",
              "title": "To"
            },
            "description": "Last month, YYYY-MM"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationStats"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/v1/stats/commencements": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Commencement Stats",
