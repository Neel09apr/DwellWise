        "operationId": "commencement_stats_v1_stats_commencements_get",
        "parameters": [
          {
            "name": "county",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z \\-]{1,30}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "County name; none means Ireland",
              "title": "County"
            },
            "description": "County name; none means Ireland"
          },
          {
            "name": "settlement",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4,6}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CSO settlement code",
              "title": "Settlement"
            },
            "description": "CSO settlement code"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First month, YYYY-MM",
              "title": "From"
            },
            "description": "First month, YYYY-MM"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last month, YYYY-MM",
              "title": "To"
            },
            "description": "Last month, YYYY-MM"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommencementStats"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    }
