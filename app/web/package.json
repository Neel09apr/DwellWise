    "react-router-dom": "7.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.8.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.4"
  }
