# Terraform working data and state never belong in git
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
# Real values live outside git; only *.example files are committed
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
.env

# App
node_modules/
dist/
app/api/.env
raw/
__pycache__/
.pytest_cache/
.ruff_cache/
.claude/launch.json
